# ============================================
# KINLOOP Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# Anthropic — https://console.anthropic.com
# Used for all Claude extraction and Coach chat
ANTHROPIC_API_KEY=

# Clerk — https://dashboard.clerk.com
# Create a new application, select "Next.js" framework
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk route configuration
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Supabase — https://supabase.com/dashboard or `supabase start` for local
# Local defaults shown; replace with hosted project values for production
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth (Calendar + Gmail) — https://console.cloud.google.com
# Enable Calendar API and Gmail API, create OAuth 2.0 credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend — https://resend.com
# Used for inbound email parsing (forwarded school emails) and outbound notifications
RESEND_API_KEY=
RESEND_INBOUND_DOMAIN=

# YouTube Data API — https://console.cloud.google.com
# Enable YouTube Data API v3, create an API key
YOUTUBE_API_KEY=

# Amazon PA-API — https://affiliate-program.amazon.com
# Used for materials lookup with affiliate links in Play Lab
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# Voyage AI embeddings — https://www.voyageai.com
# Used for RAG embeddings in the Coach quadrant
VOYAGE_API_KEY=

# Stripe — https://dashboard.stripe.com
# Used for subscription management (scaffold only, no live keys needed for V1)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App URL — set to your Vercel deployment URL in production
NEXT_PUBLIC_APP_URL=http://localhost:3000
